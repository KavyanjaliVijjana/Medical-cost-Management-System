# Backend
APP_NAME="Medical Cost Management"
APP_ENV="development"
DATABASE_URL="sqlite:///./medical_cost.db"
CORS_ORIGINS="http://localhost:5173"
ALERT_MOM_COST_THRESHOLD_PCT=5.0
ALERT_COST_PER_PATIENT_THRESHOLD_PCT=5.0
ALERT_DEPARTMENT_CONCENTRATION_THRESHOLD_PCT=30.0
ADVISOR_LLM_PROVIDER="disabled"
ADVISOR_LLM_API_KEY=""
ADVISOR_LLM_MODEL="gpt-5-mini"
ADVISOR_LLM_BASE_URL="https://api.openai.com/v1"

# Frontend (copy the relevant value to frontend/.env)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
